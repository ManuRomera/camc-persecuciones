<div class="camc-chase-container runic-biker-theme compact-layout">
  
  {{!-- HEADER: TITULO Y CONTROLES GM --}}
  <header class="camc-chase-header compact-header">
    <div class="camc-chase-title-box">
      <h2><span class="rune-icon">ᚱ</span> CONTROL VISUAL DE PERSECUCIÓN <span class="rune-icon">ᛏ</span></h2>
      <span class="camc-chase-subtitle">CUERVOS DE ASGARD MOTOR CLUB · CARRETERA Y YERMOS</span>
    </div>

    {{!-- DASHBOARD DE TERRENO Y VISIBILIDAD --}}
    <div class="camc-chase-dashboard">
      <div class="camc-dashboard-tile compact-tile">
        <label><i class="fas fa-mountain"></i> Terreno ᚠ</label>
        {{#if isGM}}
          <select class="change-terreno">
            {{#each terrenos}}
              <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}} (DF {{this.dificultad}})</option>
            {{/each}}
          </select>
        {{else}}
          <span class="camc-tile-value">{{state.terreno}}</span>
        {{/if}}
      </div>

      <div class="camc-dashboard-tile compact-tile">
        <label><i class="fas fa-smog"></i> Visibilidad ᚺ</label>
        {{#if isGM}}
          <select class="change-visibilidad">
            {{#each visibilidad}}
              <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}} ({{this.signed}})</option>
            {{/each}}
          </select>
        {{else}}
          <span class="camc-tile-value">{{state.visibilidad}}</span>
        {{/if}}
      </div>

      {{!-- DIFICULTAD BASE --}}
      <div class="camc-dashboard-tile highlight-diff compact-tile">
        <label><i class="fas fa-crosshairs"></i> Dificultad Base</label>
        <div class="camc-diff-badge">
          <span>D{{baseDifficulty}}</span>
        </div>
      </div>

      {{!-- CONTROLES Y ELIMINACIÓN DE PERSECUCIÓN --}}
      <div class="camc-dashboard-tile controls compact-tile">
        <label><i class="fas fa-tools"></i> Acciones DJ</label>
        <div class="camc-btn-group">
          <button type="button" class="btn-roll-initiatives btn-highlight-action" title="Tirar iniciativa de todos"><i class="fas fa-dice"></i> 🎲 Tirar Iniciativas</button>
          <button type="button" class="btn-toggle-guide" title="Guía Rápida de Reglas"><i class="fas fa-book-open"></i> Guía</button>
          {{#if isGM}}
            <button type="button" class="btn-show-all" title="Desplegar a todos"><i class="fas fa-bullhorn"></i> Mostrar</button>
            <button type="button" class="btn-delete-chase danger-btn" title="Finalizar y eliminar la persecución por completo"><i class="fas fa-trash-alt"></i> 🗑️ Eliminar</button>
          {{/if}}
        </div>
      </div>
    </div>
  </header>

  {{!-- PANEL DESPLEGABLE DE GUÍA RÁPIDA DE REGLAS --}}
  <section class="camc-rules-guide-panel {{#if showGuide}}open{{/if}}">
    <div class="guide-header">
      <h3><i class="fas fa-scroll"></i> 📜 GUÍA RÁPIDA DE REGLAS DE PERSECUCIÓN</h3>
      <button type="button" class="btn-close-guide" title="Cerrar guía"><i class="fas fa-times"></i></button>
    </div>

    <div class="guide-body-grid">
      <div class="guide-card">
        <h4><i class="fas fa-hourglass-half"></i> 1. Secuencia del Turno</h4>
        <ul>
          <li><b>Paso 1 · Iniciativa:</b> <code>1D + Iniciativa</code> del piloto. Pasajeros actúan en el turno de su piloto.</li>
          <li><b>Paso 2 · Declaración:</b> En <i>orden inverso a la iniciativa</i> (el menor declara primero).</li>
          <li><b>Paso 3 · Movimiento:</b> En <i>orden de iniciativa</i> (el mayor actúa primero).</li>
          <li><b>Paso 4 · Maniobras:</b> En <i>orden de iniciativa</i>. Pilotos y Pasajeros ejecutan 1 maniobra.</li>
        </ul>
      </div>

      <div class="guide-card">
        <h4><i class="fas fa-mountain"></i> 2. Dificultad y Terreno</h4>
        <ul>
          <li><b>Terreno Base:</b> Fácil (DF 8) | Media (DF 10) | Desafiante (DF 13) | Difícil (DF 16) | Muy Difícil (DF 20).</li>
          <li><b>Visibilidad:</b> Normal (+0) | Mala (+2) | Pésima (+4).</li>
          <li><b>Fórmula:</b> Terreno + Visibilidad + ModAcción - Maniobrabilidad Moto + Penalizaciones.</li>
        </ul>
      </div>

      <div class="guide-card">
        <h4><i class="fas fa-tachometer-alt"></i> 3. Acciones de Movimiento</h4>
        <ul>
          <li><b>🟢 Cambiar posición (+0 Mod):</b> Éxito = +1 Franja (+2 si es Crítico).</li>
          <li><b>⏸️ Mantener posición:</b> Sin tirada; conserva franja.</li>
          <li><b>🛡️ Obstaculizar (+2 Mod):</b> Impone +3 de dificultad al perseguidor (+6 con Crítico).</li>
          <li><b>🚀 Quemar rueda (+4 Mod):</b> Éxito = +2 Franjas (+3 si es Crítico).</li>
        </ul>
      </div>

      <div class="guide-card">
        <h4><i class="fas fa-crosshairs"></i> 4. Maniobras y Ataques</h4>
        <ul>
          <li><b>⚔️ Atacar Directo:</b> Evasión rival + 5 (piloto) o + 2 (pasajero) + Visibilidad.</li>
          <li><b>⚖️ Atacar Estabilizando:</b> Pre-tirada de Conducir vs Terreno para eliminar el +5 de piloto.</li>
          <li><b>💥 Chocar Directamente:</b> Misma franja. Conducir vs Evasión + 4 (daño dual a ambas motos).</li>
          <li><b>🚙 Embestir:</b> Misma franja. Sacrifica 1D Estructura propia -> Conducir vs Evasión + 2.</li>
        </ul>
      </div>

      <div class="guide-card full-wide">
        <h4><i class="fas fa-flag-checkered"></i> 5. Condición de Huida y Daño Grave</h4>
        <div class="guide-highlights">
          <span class="hl-badge green"><b>🏁 Huida:</b> Si un Perseguido alcanza la Franja 10 (Valhalla), escapa.</span>
          <span class="hl-badge orange"><b>💥 Interceptación:</b> Si un Perseguidor alcanza la misma franja que el Perseguido, se produce la captura.</span>
          <span class="hl-badge red"><b>⚠️ Daño Grave:</b> -3 a todas las tiradas si la Estructura de la moto cae a 50% o menos.</span>
        </div>
      </div>
    </div>
  </section>

  {{!-- PISTA TÁCTICA CON DUAL AVATAR (PERSONAJE + MOTO VINCULADA) --}}
  <section class="camc-chase-track-section compact-track-section">
    <div class="camc-track-header">
      <span><i class="fas fa-compress-arrows-alt"></i> FRANJA 1 (ᚠ ORIGEN)</span>
      <span class="camc-track-title"><i class="fas fa-road"></i> PISTA NÓRDICO-MOTERA · CARRETERA DE ASGARD</span>
      <span class="escape-text"><i class="fas fa-flag-checkered"></i> FRANJA {{state.franjasMax}} (ᛖ VALHALLA / HUIDA)</span>
    </div>

    <div class="camc-chase-track runic-track">
      {{#each franjasRunicas}}
        <div class="franja-cell {{#if this.isEscape}}escape-cell{{/if}} {{#if this.isStart}}start-cell{{/if}}" data-franja="{{this.numero}}">
          <div class="franja-number-badge"><span class="cell-rune">{{this.rune}}</span> {{this.numero}}</div>

          {{!-- PERSEGUIDORES EN ESTA FRANJA --}}
          <div class="franja-slot pursuers-slot">
            {{#each this.pursuers}}
              <div class="participant-token pursuer-token {{#if this.isControlled}}active-user-token{{/if}}" data-participant-id="{{this.id}}" title="{{this.pilotName}} montado en {{this.motoName}} (Franja {{this.franja}})">
                <img src="{{this.pilotImg}}" class="pilot-avatar" alt="{{this.pilotName}}" />
                {{#if this.motoImg}}<img src="{{this.motoImg}}" class="moto-avatar-mini" alt="{{this.motoName}}" />{{/if}}
                <span class="token-name">{{this.pilotName}}</span>
              </div>
            {{/each}}
          </div>

          <div class="franja-divider runic-divider"></div>

          {{!-- PERSEGUIDOS EN ESTA FRANJA --}}
          <div class="franja-slot evaders-slot">
            {{#each this.evaders}}
              <div class="participant-token evader-token {{#if this.isControlled}}active-user-token{{/if}}" data-participant-id="{{this.id}}" title="{{this.pilotName}} montado en {{this.motoName}} (Franja {{this.franja}})">
                <img src="{{this.pilotImg}}" class="pilot-avatar" alt="{{this.pilotName}}" />
                {{#if this.motoImg}}<img src="{{this.motoImg}}" class="moto-avatar-mini" alt="{{this.motoName}}" />{{/if}}
                <span class="token-name">{{this.pilotName}}</span>
              </div>
            {{/each}}
          </div>
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- ROSTER COMPLETO CON TARJETAS DE PERSONAJE + MOTO Y RANKING VISUAL DE INICIATIVA --}}
  <main class="camc-chase-roster-grid compact-roster-grid">
    
    {{!-- COLUMNA DE PERSEGUIDOS --}}
    <div class="camc-roster-column evaders-column">
      <div class="roster-header evader">
        <h3><i class="fas fa-shield-alt"></i> PERSEGUIDOS / CUERVOS A LA FUGA ({{perseguidos.length}})</h3>
      </div>

      <div class="roster-list">
        {{#each perseguidos}}
          <div class="participant-card evader-card {{#if this.isControlled}}controlled{{/if}}" data-participant-id="{{this.id}}">
            <div class="participant-head">
              <img src="{{this.img}}" class="avatar" alt="{{this.name}}" />
              <div class="identity">
                <h4>{{this.name}}</h4>
                <div class="meta-tags">
                  <span class="tag rank-tag" title="Posición en el orden de iniciativa">{{this.rankText}}</span>
                  <span class="tag franja-tag"><i class="fas fa-road"></i> Franja {{this.franja}}</span>
                  <span class="tag init-tag"><i class="fas fa-bolt"></i> Init: {{this.iniciativa}}</span>
                  {{#if this.healthInfo}}<span class="tag health-tag"><i class="fas fa-heart"></i> Salud: {{this.healthInfo.value}}/{{this.healthInfo.max}}</span>{{/if}}
                </div>
              </div>
              <div class="franja-controls">
                <button type="button" class="btn-move-franja" data-id="{{this.id}}" data-delta="-1" title="Retroceder 1 Franja"><i class="fas fa-chevron-left"></i></button>
                <b class="franja-val">{{this.franja}}</b>
                <button type="button" class="btn-move-franja" data-id="{{this.id}}" data-delta="1" title="Avanzar 1 Franja"><i class="fas fa-chevron-right"></i></button>
                {{#if ../isGM}}
                  <button type="button" class="btn-toggle-role" data-id="{{this.id}}" title="Cambiar a Perseguidor"><i class="fas fa-exchange-alt"></i></button>
                  <button type="button" class="btn-remove-participant danger" data-id="{{this.id}}" title="Eliminar"><i class="fas fa-times"></i></button>
                {{/if}}
              </div>
            </div>

            {{!-- TARJETA DE MOTO VINCULADA --}}
            {{#if this.mountInfo}}
              <div class="moto-badge-box compact-moto-box">
                <img src="{{this.mountInfo.img}}" class="moto-avatar" alt="{{this.mountInfo.name}}" />
                <div class="moto-meta">
                  <div class="moto-title">
                    <strong><i class="fas fa-motorcycle"></i> {{this.mountInfo.name}}</strong>
                    <span class="maniobra-badge" title="Bonificación de Maniobrabilidad del manual aplicada a la tirada">+{{this.mountInfo.maniobrabilidad}} Maniobrabilidad</span>
                  </div>
                  <div class="moto-structure-bar">
                    <div class="bar-fill" style="width: {{this.mountInfo.estructuraPct}}%;"></div>
                    <span class="bar-text">Estructura: {{this.mountInfo.estructuraVal}} / {{this.mountInfo.estructuraMax}}</span>
                  </div>
                  {{#if this.mountInfo.danoGrave}}
                    <span class="dano-grave-alert"><i class="fas fa-exclamation-triangle"></i> ¡DAÑO GRAVE! (-3)</span>
                  {{/if}}
                </div>
              </div>
            {{/if}}

            {{!-- CONTROLES INDIVIDUALES DE DADOS DE JUGADOR --}}
            {{#if this.isControlled}}
              <div class="card-roll-panel compact-roll-panel">
                <div class="roll-subgroup">
                  <label><i class="fas fa-tachometer-alt"></i> Movimiento (Dificultad Base: D{{../baseDifficulty}})</label>
                  <div class="roll-row">
                    <select class="mov-action-select" data-id="{{this.id}}">
                      {{#each ../movimientosOptions}}
                        <option value="{{this.key}}">{{this.label}} {{#if this.modText}}({{this.modText}}){{/if}} · {{this.summary}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="btn-card-roll btn-roll-mov-direct" data-id="{{this.id}}">
                      <i class="fas fa-dice-d20"></i> TIRAR DADOS CONDUCCIÓN
                    </button>
                  </div>
                </div>

                <div class="roll-subgroup">
                  <label><i class="fas fa-crosshairs"></i> Maniobra / Ataque Táctico</label>
                  <div class="roll-row">
                    <select class="man-action-select" data-id="{{this.id}}">
                      {{#each ../maniobrasOptions}}
                        <option value="{{this.key}}">{{this.label}} · {{this.summary}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="btn-card-roll btn-roll-man-direct danger" data-id="{{this.id}}">
                      <i class="fas fa-crosshairs"></i> TIRAR MANIOBRA
                    </button>
                  </div>
                </div>
              </div>
            {{/if}}

          </div>
        {{else}}
          <div class="empty-roster">
            <p><i class="fas fa-info-circle"></i> Arrastra un Personaje o Token aquí para añadirlo como Perseguido.</p>
          </div>
        {{/each}}
      </div>
    </div>

    {{!-- COLUMNA DE PERSEGUIDORES --}}
    <div class="camc-roster-column pursuers-column">
      <div class="roster-header pursuer">
        <h3><i class="fas fa-fire"></i> PERSEGUIDORES / AMENAZA NÓRDICA ({{perseguidores.length}})</h3>
      </div>

      <div class="roster-list">
        {{#each perseguidores}}
          <div class="participant-card pursuer-card {{#if this.isControlled}}controlled{{/if}}" data-participant-id="{{this.id}}">
            <div class="participant-head">
              <img src="{{this.img}}" class="avatar" alt="{{this.name}}" />
              <div class="identity">
                <h4>{{this.name}}</h4>
                <div class="meta-tags">
                  <span class="tag rank-tag" title="Posición en el orden de iniciativa">{{this.rankText}}</span>
                  <span class="tag franja-tag"><i class="fas fa-road"></i> Franja {{this.franja}}</span>
                  <span class="tag init-tag"><i class="fas fa-bolt"></i> Init: {{this.iniciativa}}</span>
                  {{#if this.healthInfo}}<span class="tag health-tag"><i class="fas fa-heart"></i> Salud: {{this.healthInfo.value}}/{{this.healthInfo.max}}</span>{{/if}}
                </div>
              </div>
              <div class="franja-controls">
                <button type="button" class="btn-move-franja" data-id="{{this.id}}" data-delta="-1" title="Retroceder 1 Franja"><i class="fas fa-chevron-left"></i></button>
                <b class="franja-val">{{this.franja}}</b>
                <button type="button" class="btn-move-franja" data-id="{{this.id}}" data-delta="1" title="Avanzar 1 Franja"><i class="fas fa-chevron-right"></i></button>
                {{#if ../isGM}}
                  <button type="button" class="btn-toggle-role" data-id="{{this.id}}" title="Cambiar a Perseguido"><i class="fas fa-exchange-alt"></i></button>
                  <button type="button" class="btn-remove-participant danger" data-id="{{this.id}}" title="Eliminar"><i class="fas fa-times"></i></button>
                {{/if}}
              </div>
            </div>

            {{!-- TARJETA DE MOTO VINCULADA --}}
            {{#if this.mountInfo}}
              <div class="moto-badge-box compact-moto-box">
                <img src="{{this.mountInfo.img}}" class="moto-avatar" alt="{{this.mountInfo.name}}" />
                <div class="moto-meta">
                  <div class="moto-title">
                    <strong><i class="fas fa-motorcycle"></i> {{this.mountInfo.name}}</strong>
                    <span class="maniobra-badge" title="Bonificación de Maniobrabilidad del manual aplicada a la tirada">+{{this.mountInfo.maniobrabilidad}} Maniobrabilidad</span>
                  </div>
                  <div class="moto-structure-bar">
                    <div class="bar-fill" style="width: {{this.mountInfo.estructuraPct}}%;"></div>
                    <span class="bar-text">Estructura: {{this.mountInfo.estructuraVal}} / {{this.mountInfo.estructuraMax}}</span>
                  </div>
                  {{#if this.mountInfo.danoGrave}}
                    <span class="dano-grave-alert"><i class="fas fa-exclamation-triangle"></i> ¡DAÑO GRAVE! (-3)</span>
                  {{/if}}
                </div>
              </div>
            {{/if}}

            {{!-- CONTROLES INDIVIDUALES DE DADOS --}}
            {{#if this.isControlled}}
              <div class="card-roll-panel compact-roll-panel">
                <div class="roll-subgroup">
                  <label><i class="fas fa-tachometer-alt"></i> Movimiento (Dificultad Base: D{{../baseDifficulty}})</label>
                  <div class="roll-row">
                    <select class="mov-action-select" data-id="{{this.id}}">
                      {{#each ../movimientosOptions}}
                        <option value="{{this.key}}">{{this.label}} {{#if this.modText}}({{this.modText}}){{/if}} · {{this.summary}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="btn-card-roll btn-roll-mov-direct" data-id="{{this.id}}">
                      <i class="fas fa-dice-d20"></i> TIRAR DADOS CONDUCCIÓN
                    </button>
                  </div>
                </div>

                <div class="roll-subgroup">
                  <label><i class="fas fa-crosshairs"></i> Maniobra / Ataque Táctico</label>
                  <div class="roll-row">
                    <select class="man-action-select" data-id="{{this.id}}">
                      {{#each ../maniobrasOptions}}
                        <option value="{{this.key}}">{{this.label}} · {{this.summary}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="btn-card-roll btn-roll-man-direct danger" data-id="{{this.id}}">
                      <i class="fas fa-crosshairs"></i> TIRAR MANIOBRA
                    </button>
                  </div>
                </div>
              </div>
            {{/if}}

          </div>
        {{else}}
          <div class="empty-roster">
            <p><i class="fas fa-info-circle"></i> Arrastra un Token con [Shift] para añadirlo como Perseguidor.</p>
          </div>
        {{/each}}
      </div>
    </div>

  </main>
</div>
